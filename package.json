{
  "name": "openapihub",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Personal, self-hosted API hub: cloud compute allowed, output stays local, remote is stream-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mamutou/openapihub.git"
  },
  "homepage": "https://github.com/mamutou/openapihub#readme",
  "bugs": {
    "url": "https://github.com/mamutou/openapihub/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "HUB_BIND=127.0.0.1 next dev --hostname 127.0.0.1 --port 43127",
    "dev:lan": "HUB_BIND=0.0.0.0 next dev --hostname 0.0.0.0 --port 43127",
    "build": "next build",
    "start": "HUB_BIND=127.0.0.1 next start --hostname 127.0.0.1 --port 43127",
    "start:lan": "HUB_BIND=0.0.0.0 next start --hostname 0.0.0.0 --port 43127",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
