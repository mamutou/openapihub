# Copy to .env and edit. Never commit real secrets.

# --- Auth / bind (review hotfix) ---
# Required when HUB_BIND is not loopback (e.g. 0.0.0.0 / LAN).
# Authorization: Bearer <token>
HUB_API_TOKEN=

# Listen intent (must match next --hostname). Default scripts use 127.0.0.1.
# LAN: npm run start:lan  → sets HUB_BIND=0.0.0.0 (Token required unless below)
HUB_BIND=127.0.0.1

# UNSAFE: allow open management/invoke without Token on non-loopback bind
# HUB_ALLOW_OPEN=1

# Optional: treat extra hosts as local for locality inference
# HUB_LOCAL_HOST_ALLOWLIST=my-nas.home,gateway.local

# Where backends / policy / invocation metadata are stored
HUB_DATA_DIR=./data

# Keep last N invocation metadata rows (bodies still omitted unless retainPayloads)
HUB_INVOCATION_LIMIT=200

# Upstream timeouts (milliseconds)
UNARY_TIMEOUT_MS=30000
STREAM_CONNECT_TIMEOUT_MS=60000

# Max invoke request body (bytes). 8 MiB default; oversize → 413.
# HUB_MAX_BODY_BYTES=8388608

# Upstream auth: a Backend's headerEnv maps a header to an env var NAME
# (values are never stored). Export the secret here before starting the hub.
# OPENAI_API_KEY=sk-...
# HA_TOKEN=

# --- Probe only (Hub does NOT proxy these secrets) ---
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2

HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=

# Force file persistence on/off (tests set HUB_PERSIST=0 by default via VITEST)
# HUB_PERSIST=1
